# --- Build stage ---
FROM rust:1.88.0-bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY packages/ packages/
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
# Source revision bound into the relay configuration hash (transcript v3).
ARG SELKEY_TEE_GIT_REV=unknown
RUN SELKEY_TEE_GIT_REV="${SELKEY_TEE_GIT_REV}" cargo build --release -p tee-relay

# --- Runtime stage ---
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home selkeytee
USER selkeytee
COPY --from=builder /build/target/release/tee-relay /usr/local/bin/tee-relay
VOLUME ["/var/lib/selkey-tee"]
ENV SELKEY_TEE_DATA_DIR=/var/lib/selkey-tee
EXPOSE 3100
ENTRYPOINT ["tee-relay"]
